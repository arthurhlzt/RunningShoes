generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon com pooler (usada pela aplicação)
  directUrl = env("DIRECT_URL") // Neon direta, sem pooler (usada pelo Prisma CLI: migrate)
}

enum Genero {
  MASCULINO
  FEMININO
  UNISSEX
}

enum Terreno {
  ASFALTO
  TRILHA
}

enum Distancia {
  CINCO_K
  DEZ_K
  MARATONA
}

enum StatusPedido {
  PENDENTE
  PAGO
  ENVIADO
  CANCELADO
}

model Marca {
  id    Int     @id @default(autoincrement())
  nome  String  @unique @db.VarChar(30)
  tenis Tenis[]

  @@map("marcas")
}

model Tenis {
  id        Int       @id @default(autoincrement())
  modelo    String    @db.VarChar(60)
  preco     Decimal   @db.Decimal(10, 2)
  genero    Genero
  terreno   Terreno
  distancia Distancia
  drop      Int // em mm
  peso      Int // em gramas
  foto      String // URL do Cloudinary

  // preenchidos pela IA (Gemini) no cadastro; podem ficar vazios se ela falhar
  pontosFortes  String[]
  pontosFracos  String[]
  amortecimento String?  @db.VarChar(20)

  marcaId   Int
  marca     Marca      @relation(fields: [marcaId], references: [id])
  variacoes Variacao[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("tenis")
}

// Estoque por modelo + tamanho + cor
model Variacao {
  id         Int          @id @default(autoincrement())
  tamanho    Int
  cor        String       @db.VarChar(30)
  quantidade Int          @default(0)
  tenisId    Int
  tenis      Tenis        @relation(fields: [tenisId], references: [id], onDelete: Cascade)
  itens      ItemPedido[]

  @@unique([tenisId, tamanho, cor])
  @@map("variacoes")
}

model Cliente {
  id        String   @id @default(uuid()) @db.VarChar(36)
  nome      String   @db.VarChar(60)
  email     String   @unique @db.VarChar(100)
  senha     String?  @db.VarChar(60) // nulo para quem entra só com o Google
  googleId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pedidos   Pedido[]

  @@map("clientes")
}

model Admin {
  id    String @id @default(uuid()) @db.VarChar(36)
  nome  String @db.VarChar(60)
  email String @unique @db.VarChar(100)
  senha String @db.VarChar(60)

  @@map("admins")
}

model Pedido {
  id        Int          @id @default(autoincrement())
  status    StatusPedido @default(PENDENTE)
  total     Decimal      @db.Decimal(10, 2)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  clienteId String       @db.VarChar(36)
  cliente   Cliente      @relation(fields: [clienteId], references: [id])
  itens     ItemPedido[]

  // endereço de entrega: fica gravado no pedido (não muda se o cliente mudar de endereço depois)
  telefone    String  @db.VarChar(11)
  cep         String  @db.VarChar(8)
  logradouro  String  @db.VarChar(100)
  numero      String  @db.VarChar(10)
  complemento String? @db.VarChar(50)
  bairro      String  @db.VarChar(60)
  cidade      String  @db.VarChar(60)
  uf          String  @db.VarChar(2)

  @@map("pedidos")
}

model ItemPedido {
  id            Int      @id @default(autoincrement())
  quantidade    Int
  precoUnitario Decimal  @db.Decimal(10, 2)
  pedidoId      Int
  variacaoId    Int
  pedido        Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  variacao      Variacao @relation(fields: [variacaoId], references: [id])

  @@map("itens_pedido")
}
