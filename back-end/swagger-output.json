    "/tenis/": {
      "get": {
        "tags": [
          "Tênis"
        ],
        "summary": "Lista os tênis (vitrine)",
        "description": "Retorna os tênis com marca e variações em estoque. Aceita filtros opcionais.",
        "parameters": [
          {
            "name": "marcaId",
            "in": "query",
            "required": false,
            "description": "Código da marca",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "genero",
            "in": "query",
            "required": false,
            "description": "MASCULINO, FEMININO ou UNISSEX",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "terreno",
            "in": "query",
            "required": false,
            "description": "ASFALTO ou TRILHA",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "distancia",
            "in": "query",
            "required": false,
            "description": "CINCO_K, DEZ_K ou MARATONA",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "busca",
            "in": "query",
            "required": false,
            "description": "Parte do modelo",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de tênis."
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Tênis"
        ],
        "summary": "Cadastra um tênis",
        "description": "Recebe os dados em multipart/form-data com a foto. A foto vai para o Cloudinary e a IA (Gemini) completa pontos fortes/fracos e amortecimento. Se a IA falhar, o tênis é salvo sem esses dados.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Tênis cadastrado."
          },
          "400": {
            "description": "Dados inválidos ou foto não enviada."
          },
          "401": {
            "description": "Não autenticado."
          },
          "403": {
            "description": "Acesso restrito ao administrador."
          },
          "404": {
            "description": "Marca não encontrada."
          },
          "409": {
            "description": "Conflict"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "foto",
                  "modelo",
                  "preco",
                  "genero",
                  "terreno",
                  "distancia",
                  "drop",
                  "peso",
                  "marcaId"
                ],
                "properties": {
                  "foto": {
                    "type": "string",
                    "format": "binary",
                    "description": "Foto do tênis (imagem até 5 MB)"
                  },
                  "modelo": {
                    "type": "string",
                    "example": "Pegasus 41"
                  },
                  "preco": {
                    "type": "number",
                    "example": 899.9
                  },
                  "genero": {
                    "type": "string",
                    "enum": [
                      "MASCULINO",
                      "FEMININO",
                      "UNISSEX"
                    ]
                  },
                  "terreno": {
                    "type": "string",
                    "enum": [
                      "ASFALTO",
                      "TRILHA"
                    ]
                  },
                  "distancia": {
                    "type": "string",
                    "enum": [
                      "CINCO_K",
                      "DEZ_K",
                      "MARATONA"
                    ]
                  },
                  "drop": {
                    "type": "integer",
                    "description": "Drop em mm",
                    "example": 10
                  },
                  "peso": {
                    "type": "integer",
                    "description": "Peso em gramas",
                    "example": 290
                  },
                  "marcaId": {
                    "type": "integer",
                    "example": 1
                  }
                }
              }
            }
          }
        }
      }
    },
