    "/pedidos/": {
      "post": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Cria um pedido",
        "description": "Cria o pedido do cliente logado com o endereço de entrega e baixa o estoque de cada variação (tamanho/cor) em uma transação. Se faltar estoque em qualquer item, nada é gravado.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Pedido criado com status PENDENTE."
          },
          "400": {
            "description": "Dados inválidos."
          },
          "401": {
            "description": "Não autenticado."
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Variação não encontrada."
          },
          "409": {
            "description": "Estoque insuficiente."
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "itens": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "variacaoId": {
                          "type": "number",
                          "example": 1
                        },
                        "quantidade": {
                          "type": "number",
                          "example": 2
                        }
                      }
                    }
                  },
                  "entrega": {
                    "type": "object",
                    "properties": {
                      "telefone": {
                        "type": "string",
                        "example": "53999998888"
                      },
                      "cep": {
                        "type": "string",
                        "example": "96010000"
                      },
                      "logradouro": {
                        "type": "string",
                        "example": "Rua Quinze de Novembro"
                      },
                      "numero": {
                        "type": "string",
                        "example": "100"
                      },
                      "complemento": {
                        "type": "string",
                        "example": "Apto 12"
                      },
                      "bairro": {
                        "type": "string",
                        "example": "Centro"
                      },
                      "cidade": {
                        "type": "string",
                        "example": "Pelotas"
                      },
                      "uf": {
                        "type": "string",
                        "example": "RS"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
