      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Cadastra um cliente",
        "description": "Cadastro tradicional com e-mail e senha. A senha é salva criptografada.",
        "responses": {
          "201": {
            "description": "Cliente cadastrado com sucesso."
          },
          "400": {
            "description": "Dados inválidos."
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "E-mail já cadastrado."
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string",
                    "example": "João da Silva"
                  },
                  "email": {
                    "type": "string",
                    "example": "joao@email.com"
                  },
                  "senha": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        }
      }
    },
