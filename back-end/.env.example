# Neon: copie as duas strings em Connect > Connection string do painel do Neon.
# DATABASE_URL = com pooler (host contém "-pooler"). Usada pela API.
DATABASE_URL="postgresql://neondb_owner:SENHA@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# DIRECT_URL = sem pooler (o mesmo host, sem "-pooler"). Usada em migrate/seed pelo Prisma CLI.
DIRECT_URL="postgresql://neondb_owner:SENHA@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
JWT_KEY="troque-por-uma-chave-longa-e-aleatoria"

GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"

GEMINI_API_KEY="xxx"
GEMINI_MODEL="gemini-3.6-flash"

CLOUDINARY_CLOUD_NAME="xxx"
CLOUDINARY_API_KEY="xxx"
CLOUDINARY_API_SECRET="xxx"

# usados apenas pelo seed para criar o administrador
ADMIN_EMAIL="admin@loja.com"
ADMIN_SENHA="troque-esta-senha"

# URL do front-end liberada no CORS (Vercel em produção)
FRONT_URL="http://localhost:5173"
PORT=3000
